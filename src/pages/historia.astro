---
import MainLayout from '../layouts/MainLayout.astro';
import Container from '../components/layout/Container.astro';
import Section from '../components/layout/Section.astro';
import PageHeader from '../components/layout/PageHeader.astro';
import Breadcrumbs from '../components/navigation/Breadcrumbs.astro';
import { getParishPage } from '../services/parish-pages';
const page = await getParishPage('historia');
---
<MainLayout seo={{ title: page.title, description: page.description, canonicalPath: '/historia' }}>
  <Breadcrumbs items={[{ label: page.title }]} /><PageHeader title={page.title} introduction={page.description} />
  <Section><Container><div class="grid items-start gap-10 lg:grid-cols-[1.2fr_1fr]">
    <article class="space-y-6 text-lg leading-8">
      {page.content.split(/\n\s*\n/).map((paragraph) => <p>{paragraph}</p>)}
      {page.source_url && <p class="border-t border-line pt-5 text-sm text-muted">Źródło opracowania: <a href={page.source_url} class="text-navy underline">opis parafii</a>.</p>}
      <a href="/kontakt" class="inline-block font-semibold text-navy underline">Odwiedź naszą parafię</a>
    </article>
    <figure><img src="/images/parafia-hero.jpg" alt="Drewniany kościół Trójcy Świętej w Żeliszewie" width="1024" height="720" class="aspect-[4/3] w-full rounded-xl object-cover" /><figcaption class="mt-3 text-sm text-muted">Kościół Trójcy Świętej w Żeliszewie</figcaption></figure>
  </div></Container></Section>
</MainLayout>
