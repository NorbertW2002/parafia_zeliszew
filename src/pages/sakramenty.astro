---
import { getEntry, render } from 'astro:content';
import MainLayout from '../layouts/MainLayout.astro';
import PageHeader from '../components/layout/PageHeader.astro';
import Container from '../components/layout/Container.astro';
import Section from '../components/layout/Section.astro';
import Breadcrumbs from '../components/navigation/Breadcrumbs.astro';
import { getSacraments } from '../services/sacraments';

const page = await getEntry('pages', 'sakramenty');
if (!page) throw new Error('Missing sacraments page content');
const { Content } = await render(page);
const sacraments = await getSacraments();
---
<MainLayout seo={{ title: page.data.title, description: page.data.description, canonicalPath: '/sakramenty' }}>
  <Breadcrumbs items={[{ label: page.data.title }]} />
  <PageHeader title={page.data.title} introduction={page.data.description} />
  <Section>
    <Container>
      <details class="mb-6 rounded-lg border border-line bg-surface p-4 lg:hidden"><summary class="cursor-pointer font-semibold text-navy">Wybierz sakrament</summary><nav aria-label="Wybierz sakrament"><ul class="mt-3 space-y-1">{sacraments.map((item) => <li><a class="block rounded-md px-3 py-3 text-navy hover:bg-gold-light" href={`#${item.slug}`}>{item.title}</a></li>)}</ul></nav></details>
      <div class="grid gap-10 lg:grid-cols-[16rem_minmax(0,1fr)]">
        <nav aria-label="Sakramenty — przejdź do opisu" class="hidden self-start rounded-lg lg:block border border-line bg-surface p-5 lg:sticky lg:top-6">
          <p class="mb-3 hidden font-semibold text-navy lg:block">Na tej stronie</p>
          <ul class="space-y-1">
            {sacraments.map((item) => <li><a href={`#${item.slug}`} class="block rounded-md px-3 py-2 text-navy hover:bg-gold-light">{item.title}</a></li>)}
          </ul>
          <a href="/kancelaria-parafialna" class="mt-5 block border-t border-line pt-4 font-semibold text-navy underline">Kancelaria parafialna</a>
          <a href="/kontakt" class="mt-3 block font-semibold text-navy underline">Kontakt z parafią</a>
        </nav>
        <div class="min-w-0 space-y-6">
          <div class="space-y-4 rounded-lg bg-surface p-6 [&_a]:text-navy [&_a]:underline"><Content /></div>
          {sacraments.map((item) => (
            <section id={item.slug} aria-labelledby={`${item.slug}-title`} class="scroll-mt-6 space-y-5 rounded-lg border border-line p-6 sm:p-8">
              <h2 id={`${item.slug}-title`}>{item.title}</h2>
              <p class="whitespace-pre-line text-muted">{item.description}</p>
              <div class="space-y-2"><h3 class="text-xl">Jak się przygotować?</h3><p class="whitespace-pre-line">{item.preparation}</p></div>
              {item.documents && <div class="space-y-2"><h3 class="text-xl">Dokumenty i formalności</h3><p class="whitespace-pre-line">{item.documents}</p></div>}
            </section>
          ))}
        </div>
      </div>
    </Container>
  </Section>
</MainLayout>
