---
interface Props { title: string; introduction?: string; }
const { title, introduction } = Astro.props;
---
<header class="border-b border-line bg-surface py-8 sm:py-12">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <h1>{title}</h1>
    {introduction && <p class="mt-4 max-w-3xl text-lg text-muted">{introduction}</p>}
  </div>
</header>
