---
import { siteConfig } from '../../config/site';
import type { SeoMetadata } from '../../types/content';
interface Props { seo?: SeoMetadata; noindex?: boolean; }
const { seo = {}, noindex = false } = Astro.props;
const title = seo.title ? `${seo.title} | ${siteConfig.name}` : siteConfig.name;
const description = seo.description ?? siteConfig.description;
const canonical = new URL(seo.canonicalPath ?? Astro.url.pathname, Astro.site ?? Astro.url.origin).toString();
---
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<meta property="og:type" content="website" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
{seo.image && <meta property="og:image" content={seo.image} />}
{noindex && <meta name="robots" content="noindex, nofollow" />}
