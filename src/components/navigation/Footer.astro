---
import { footerLinks, siteConfig } from '../../config/site';
import { getParishPage, contactLinks } from '../../services/parish-pages';
const contact = await getParishPage('kontakt');
const links = contactLinks(contact);
const year = new Date().getFullYear();
---
<footer class="mt-auto bg-navy py-12 text-slate-100">
  <div class="mx-auto grid max-w-6xl gap-10 px-4 sm:grid-cols-2 sm:px-6 lg:grid-cols-2 lg:px-8">
    <section aria-labelledby="footer-parish">
      <h2 id="footer-parish" class="font-serif text-2xl text-white">{siteConfig.name}</h2>
      <p class="mt-3 text-slate-200">{contact.address}<br />{contact.postal_address}</p>
      {contact.phone && <a class="mt-2 block hover:text-gold-light focus-visible:outline-gold-light" href={links.phone}>{contact.phone}</a>}
      {contact.email && <a class="mt-2 block hover:text-gold-light focus-visible:outline-gold-light" href={`mailto:${contact.email}`}>{contact.email}</a>}
    </section>
    <nav aria-label="Skróty w stopce"><h2 class="font-serif text-2xl text-white">Skróty</h2><ul class="mt-3 space-y-2">
      {footerLinks.map((item) => <li><a class="hover:text-gold-light focus-visible:outline-gold-light" href={item.href}>{item.label}</a></li>)}
    </ul></nav>
    {siteConfig.socialLinks.length > 0 && <nav aria-label="Media społecznościowe"><h2 class="font-serif text-2xl text-white">Znajdź nas</h2><ul class="mt-3 space-y-2">
      {siteConfig.socialLinks.map((item) => <li><a class="hover:text-gold-light focus-visible:outline-gold-light" href={item.href}>{item.label}</a></li>)}
    </ul></nav>}
  </div>
  <div class="mx-auto mt-10 max-w-6xl border-t border-slate-600 px-4 pt-6 text-sm text-slate-300 sm:px-6 lg:px-8">© {year} {siteConfig.name}. Wszelkie prawa zastrzeżone.</div>
</footer>
