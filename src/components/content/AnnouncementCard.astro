---
import Card from '../ui/Card.astro';
import Badge from '../ui/Badge.astro';
import { formatDate } from '../../utils/date';
import { excerpt, toPlainText } from '../../utils/text';
import type { Announcement } from '../../types/content';

interface Props {
  announcement: Announcement;
}

const { announcement } = Astro.props;

const preview = excerpt(toPlainText(announcement.content));
const image = announcement.attachments.find((attachment) => attachment.type?.startsWith('image/'));
---

<Card class="flex h-full flex-col">
  {image && <a href={`/ogloszenia/${announcement.slug}`} class="mb-5 block overflow-hidden rounded-lg bg-surface" aria-label={`Zobacz ogłoszenie: ${announcement.title}`}>
    <img src={image.url} alt={image.alt} loading="lazy" class="aspect-[4/3] w-full object-contain" />
  </a>}
  <Badge>{formatDate(announcement.publishedAt)}</Badge>

  <h2 class="mt-4 text-2xl">
    <a
        class="hover:text-gold"
        href={`/ogloszenia/${announcement.slug}`}
    >
      {announcement.title}
    </a>
  </h2>

  <p class="mt-3 text-muted">
    {preview}
  </p>

  <a
      class="mt-5 font-semibold text-navy hover:text-gold"
      href={`/ogloszenia/${announcement.slug}`}
  >
    Czytaj ogłoszenie
    <span class="sr-only">: {announcement.title}</span>
  </a>
</Card>
