{
  "collection": "parish_pages",
  "meta": {
    "icon": "article",
    "display_template": "{{title}}",
    "archive_field": "status",
    "archive_value": "archived",
    "unarchive_value": "draft",
    "translations": [
      {
        "language": "pl-PL",
        "translation": "Kontakt i historia"
      }
    ]
  },
  "schema": {},
  "fields": [
    {
      "field": "id",
      "type": "uuid",
      "meta": {
        "hidden": true,
        "special": [
          "uuid"
        ]
      },
      "schema": {
        "is_primary_key": true,
        "is_nullable": false
      }
    },
    {
      "field": "slug",
      "type": "string",
      "meta": {
        "interface": "select-dropdown",
        "required": true,
        "options": {
          "choices": [
            {
              "text": "Kontakt",
              "value": "kontakt"
            },
            {
              "text": "Historia parafii",
              "value": "historia"
            }
          ]
        }
      },
      "schema": {
        "is_unique": true,
        "is_nullable": false
      }
    },
    {
      "field": "status",
      "type": "string",
      "meta": {
        "interface": "select-dropdown",
        "options": {
          "choices": [
            {
              "text": "Szkic",
              "value": "draft"
            },
            {
              "text": "Opublikowany",
              "value": "published"
            },
            {
              "text": "Archiwalny",
              "value": "archived"
            }
          ]
        }
      },
      "schema": {
        "default_value": "draft",
        "is_nullable": false
      }
    },
    {
      "field": "title",
      "type": "string",
      "meta": {
        "interface": "input",
        "required": true,
        "translations": [
          {
            "language": "pl-PL",
            "translation": "Tytuł"
          }
        ]
      },
      "schema": {
        "is_nullable": false
      }
    },
    {
      "field": "description",
      "type": "text",
      "meta": {
        "interface": "input-multiline",
        "required": true,
        "translations": [
          {
            "language": "pl-PL",
            "translation": "Krótki opis"
          }
        ]
      },
      "schema": {
        "is_nullable": false
      }
    },
    {
      "field": "content",
      "type": "text",
      "meta": {
        "interface": "input-multiline",
        "required": true,
        "translations": [
          {
            "language": "pl-PL",
            "translation": "Treść (akapity oddziel pustą linią)"
          }
        ]
      },
      "schema": {
        "is_nullable": false
      }
    },
    {
      "field": "address",
      "type": "string",
      "meta": {
        "interface": "input",
        "required": false,
        "translations": [
          {
            "language": "pl-PL",
            "translation": "Ulica i numer"
          }
        ]
      },
      "schema": {
        "is_nullable": true
      }
    },
    {
      "field": "postal_address",
      "type": "string",
      "meta": {
        "interface": "input",
        "required": false,
        "translations": [
          {
            "language": "pl-PL",
            "translation": "Kod pocztowy i miejscowość"
          }
        ]
      },
      "schema": {
        "is_nullable": true
      }
    },
    {
      "field": "phone",
      "type": "string",
      "meta": {
        "interface": "input",
        "required": false,
        "translations": [
          {
            "language": "pl-PL",
            "translation": "Telefon"
          }
        ]
      },
      "schema": {
        "is_nullable": true
      }
    },
    {
      "field": "email",
      "type": "string",
      "meta": {
        "interface": "input",
        "required": false,
        "translations": [
          {
            "language": "pl-PL",
            "translation": "E-mail"
          }
        ]
      },
      "schema": {
        "is_nullable": true
      }
    },
    {
      "field": "office_hours",
      "type": "text",
      "meta": {
        "interface": "input-multiline",
        "required": false,
        "translations": [
          {
            "language": "pl-PL",
            "translation": "Godziny kancelarii"
          }
        ]
      },
      "schema": {
        "is_nullable": true
      }
    },
    {
      "field": "source_url",
      "type": "string",
      "meta": {
        "interface": "input",
        "required": false,
        "translations": [
          {
            "language": "pl-PL",
            "translation": "Adres źródła informacji"
          }
        ]
      },
      "schema": {
        "is_nullable": true
      }
    }
  ]
}
